# Sanity CMS — create a project at https://www.sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Used for sitemap, Open Graph, and canonical URLs
PUBLIC_SITE_URL=https://pulsative-site.pages.dev

# Editor token for seeding / scripts (create at sanity.io/manage → API → Tokens)
# Needs Editor role (create + upload). Do not commit a real token.
# SANITY_API_TOKEN=
#
# Alternative without a token file entry:
#   npx sanity exec scripts/seed-sanity.mjs --with-user-token

# Optional: webhook secret for Sanity → Cloudflare Pages deploy hooks
SANITY_REVALIDATE_SECRET=your-random-secret
