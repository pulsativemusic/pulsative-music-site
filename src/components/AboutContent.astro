---
import type { AboutContent } from '../lib/types';
import { portableTextToHtml } from '../lib/portable-text';

interface AboutUi {
  lineup: string;
}

interface Props {
  about: AboutContent;
  bandName: string;
  ui: AboutUi;
}

const { about, bandName, ui } = Astro.props;
const bioHtml = portableTextToHtml(about.bio);
---

<div class="about-grid">
  {
    about.bandPhotoUrl && (
      <img
        class="band-photo reveal"
        src={about.bandPhotoUrl}
        alt={bandName}
        loading="lazy"
        width={1200}
        height={800}
      />
    )
  }

  {bioHtml && <div class="bio reveal" set:html={bioHtml} />}

  {
    about.members.length > 0 && (
      <div class="members">
        <h2 class="section-title reveal">{ui.lineup}</h2>
        <div class="member-grid">
          {
            about.members.map((member) => (
              <article class="member-card reveal">
                {member.photoUrl && (
                  <img src={member.photoUrl} alt={member.name} loading="lazy" width={200} height={200} />
                )}
                <div>
                  <h3>{member.name}</h3>
                  {member.role && <p class="member-role">{member.role}</p>}
                  {member.bio && <p class="text-muted">{member.bio}</p>}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    )
  }
</div>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .band-photo {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .bio {
    max-width: 42rem;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .bio :global(p) {
    margin-bottom: 1em;
  }

  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .bio :global(strong) {
    font-weight: 700;
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .member-card {
    display: grid;
    gap: var(--space-sm);
  }

  .member-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: grayscale(20%);
  }

  .member-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.15rem;
  }

  .member-role {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
</style>
