---
import type { AboutContent } from '../lib/types';
import { portableTextToHtml } from '../lib/portable-text';

interface AboutUi {
  lineup: string;
}

interface Props {
  about: AboutContent;
  bandName: string;
  title: string;
  ui: AboutUi;
}

const { about, bandName, title, ui } = Astro.props;
const bioHtml = portableTextToHtml(about.bio);
const hasPhoto = Boolean(about.bandPhotoUrl);
---

<div class="about">
  <div class:list={['about-split', { 'has-photo': hasPhoto }]}>
    <div class="about-copy">
      <h1 class="page-title reveal">{title}</h1>
      {bioHtml && <div class="bio reveal reveal-delay-1" set:html={bioHtml} />}
    </div>

    {
      about.bandPhotoUrl && (
        <img
          class="band-photo reveal reveal-delay-1"
          src={about.bandPhotoUrl}
          alt={bandName}
          loading="eager"
          width={1200}
          height={800}
        />
      )
    }
  </div>

  {
    about.members.length > 0 && (
      <div class="members">
        <h2 class="section-title reveal">{ui.lineup}</h2>
        <div class="member-grid">
          {
            about.members.map((member) => (
              <article class="member-card reveal">
                {member.photoUrl && (
                  <img src={member.photoUrl} alt={member.name} loading="lazy" width={200} height={200} />
                )}
                <div>
                  <h3>{member.name}</h3>
                  {member.role && <p class="member-role">{member.role}</p>}
                  {member.bio && <p class="text-muted">{member.bio}</p>}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    )
  }
</div>

<style>
  .about {
    display: grid;
    gap: var(--space-2xl);
  }

  .about-split {
    display: grid;
    gap: var(--space-lg);
  }

  .about-copy {
    min-width: 0;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin-bottom: var(--space-md);
  }

  .band-photo {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .bio {
    max-width: 42rem;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .bio :global(p) {
    margin-bottom: 0.85em;
  }

  .bio :global(p:last-child) {
    margin-bottom: 0;
  }

  .bio :global(strong) {
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .about-split.has-photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .page-title {
      font-size: clamp(2.25rem, 3.5vw, 3.75rem);
      margin-bottom: var(--space-sm);
    }

    .band-photo {
      height: min(32rem, calc(100svh - var(--header-height) - var(--announcement-banner-height) - 6rem));
      max-height: none;
      object-fit: cover;
    }
  }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .member-card {
    display: grid;
    gap: var(--space-sm);
  }

  .member-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: grayscale(20%);
  }

  .member-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.15rem;
  }

  .member-role {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
</style>
