---
import type { Gallery } from '../lib/types';
import { formatShortDate } from '../lib/utils';

interface Props {
  galleries: Gallery[];
}

const { galleries } = Astro.props;
---

{
  galleries.length === 0 ? (
    <p class="empty text-muted">No photo galleries yet.</p>
  ) : (
    <div class="gallery-grid">
      {galleries.map((gallery) => (
        <a href={`/photos/${gallery.slug}`} class="gallery-card">
          {gallery.coverUrl && (
            <img
              src={gallery.coverUrl}
              alt={gallery.title}
              loading="lazy"
              width={600}
              height={400}
            />
          )}
          <div class="gallery-card-content">
            <h3>{gallery.title}</h3>
            <p class="text-muted">
              {gallery.showDate && formatShortDate(gallery.showDate)}
              {gallery.venue && ` — ${gallery.venue}`}
            </p>
            <span class="gallery-count">{gallery.photos.length} photos</span>
          </div>
        </a>
      ))}
    </div>
  )
}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
  }

  .gallery-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition:
      transform var(--transition-base),
      border-color var(--transition-fast);
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-hover-border);
  }

  .gallery-card img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .gallery-card:hover img {
    transform: scale(1.05);
  }

  .gallery-card-content {
    padding: var(--space-md);
  }

  .gallery-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .gallery-count {
    display: inline-block;
    margin-top: var(--space-xs);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .empty {
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
