---
import HeroAnimation from './islands/HeroAnimation';
import ShowreelTeaser from './ShowreelTeaser.astro';
import type { Locale, Showreel, SiteSettings } from '../lib/types';
import { getUi, pickLocalized } from '../lib/i18n';

interface Props {
  settings: SiteSettings;
  locale: Locale;
  showreel?: Showreel | null;
}

const { settings, locale, showreel = null } = Astro.props;
const ui = getUi(locale);
const taglineLine1 = pickLocalized(settings.taglineLine1, locale);
const taglineLine2 = pickLocalized(settings.taglineLine2, locale);

const heroMobileUrl = settings.heroImageMobileUrl ?? settings.heroImageUrl;
const heroDesktopUrl = settings.heroImageDesktopUrl ?? settings.heroImageUrl;
const heroWideUrl = settings.heroImageWideUrl ?? heroDesktopUrl ?? settings.heroImageUrl;

const heroStackStyle = [
  settings.heroObjectPositionMobile || settings.heroObjectPosition
    ? `--hero-pos-mobile: ${settings.heroObjectPositionMobile ?? settings.heroObjectPosition}`
    : null,
  settings.heroObjectPositionDesktop || settings.heroObjectPosition
    ? `--hero-pos-desktop: ${settings.heroObjectPositionDesktop ?? settings.heroObjectPosition}`
    : null,
  settings.heroObjectPositionWide ||
  settings.heroObjectPositionDesktop ||
  settings.heroObjectPosition
    ? `--hero-pos-wide: ${settings.heroObjectPositionWide ?? settings.heroObjectPositionDesktop ?? settings.heroObjectPosition}`
    : null,
]
  .filter(Boolean)
  .join('; ');
---

<div
  class="home-hero-stack"
  style={heroStackStyle || undefined}
>
  <section class="hero">
    {
      settings.heroVideoUrl ? (
        <video
          class="hero-bg"
          src={settings.heroVideoUrl}
          autoplay
          muted
          loop
          playsinline
          poster={settings.heroImageUrl}
        />
      ) : (
        heroMobileUrl && (
          <div class="hero-media" aria-hidden="true">
            <picture>
              {heroWideUrl && (
                <source media="(min-width: 1440px)" srcset={heroWideUrl} />
              )}
              {heroDesktopUrl && (
                <source media="(min-width: 1101px)" srcset={heroDesktopUrl} />
              )}
              <img
                class="hero-bg hero-bg--blur"
                src={heroMobileUrl}
                alt=""
                width={1920}
                height={1080}
              />
            </picture>
            <picture>
              {heroWideUrl && (
                <source media="(min-width: 1440px)" srcset={heroWideUrl} />
              )}
              {heroDesktopUrl && (
                <source media="(min-width: 1101px)" srcset={heroDesktopUrl} />
              )}
              <img
                class="hero-bg hero-bg--sharp"
                src={heroMobileUrl}
                alt=""
                fetchpriority="high"
                width={1920}
                height={1080}
              />
            </picture>
          </div>
        )
      )
    }
    <div class="hero-overlay"></div>

    <div class="container hero-content">
      {
        settings.logoUrl ? (
          <img class="hero-logo" src={settings.logoUrl} alt={settings.bandName} width={320} height={120} />
        ) : (
          <HeroAnimation
            client:load
            bandName={settings.bandName}
            taglineLine1={taglineLine1}
            taglineLine2={taglineLine2}
          />
        )
      }

      {
        settings.logoUrl && (
          <div class="hero-text-static">
            <p class="hero-tagline">
              {taglineLine1 && <span class="hero-tagline-line">{taglineLine1}</span>}
              {taglineLine2 && <span class="hero-tagline-line">{taglineLine2}</span>}
            </p>
          </div>
        )
      }
    </div>

    {!showreel && (
      <div class="hero-scroll" aria-hidden="true">
        <span>{ui.home.scroll}</span>
        <div class="scroll-line"></div>
      </div>
    )}
  </section>

  {showreel && <ShowreelTeaser showreel={showreel} locale={locale} />}
</div>

<style>
  .home-hero-stack {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  .hero {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 80svh;
    min-height: 20rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--hero-pos-mobile, center top);
  }

  .hero-bg--blur {
    z-index: 0;
    filter: blur(28px) brightness(0.55);
    transform: scale(1.08);
  }

  .hero-bg--sharp {
    z-index: 1;
  }

  @media (max-width: 1100px) and (orientation: landscape) {
    .hero-bg--sharp {
      object-fit: contain;
    }
  }

  @media (min-width: 600px) and (max-width: 1100px) and (orientation: portrait) {
    .hero-bg--sharp {
      object-fit: contain;
    }
  }

  @media (min-width: 1101px) {
    .hero-bg {
      object-position: var(--hero-pos-desktop, var(--hero-pos-mobile, center top));
    }
  }

  @media (min-width: 1440px) {
    .hero-bg {
      object-position: var(--hero-pos-wide, var(--hero-pos-desktop, center top));
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse at 20% 40%, rgba(232, 255, 0, 0.08), transparent 55%),
      radial-gradient(ellipse at 80% 60%, rgba(232, 255, 0, 0.04), transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 100%;
    padding-block: var(--space-md);
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* logo glow breath — runs after entrance settles */
  @keyframes hero-logo-pulse {
    0%, 100% {
      filter: drop-shadow(0 0 18px rgba(232, 255, 0, 0.10));
    }
    50% {
      filter: drop-shadow(0 0 36px rgba(232, 255, 0, 0.32)) drop-shadow(0 0 8px rgba(232, 255, 0, 0.18));
    }
  }

  /* border accent: scale in from left */
  @keyframes hero-line-grow {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* border accent: idle shimmer loop */
  @keyframes hero-border-idle {
    0%, 100% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.9;
    }
  }

  .hero-logo {
    max-width: min(20rem, 70vw);
    height: auto;
    margin-bottom: var(--space-md);
    animation:
      hero-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both,
      hero-logo-pulse 4s ease-in-out 1.2s infinite;
  }

  .hero-text-static .hero-tagline {
    position: relative;
    font-size: clamp(0.95rem, 2.2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    max-width: 42rem;
    margin: 0;
    line-height: 1.55;
    padding-inline-start: 0.85rem;
    /* border handled by ::before so we can animate it */
    border-left: none;
    animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both;
  }

  /* animated left accent bar */
  .hero-text-static .hero-tagline::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 2px;
    background: rgba(232, 255, 0, 0.45);
    transform-origin: top;
    transform: scaleX(1); /* keep it horizontal — scaleY for vertical reveal */
    animation:
      hero-line-grow 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both,
      hero-border-idle 6s ease-in-out 1.4s infinite;
  }

  /* fix scaleX → use scaleY for a vertical bar */
  @keyframes hero-line-grow {
    from {
      transform: scaleY(0);
      opacity: 0;
    }
    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  .hero-text-static .hero-tagline-line {
    display: block;
  }

  .hero-text-static .hero-tagline-line:nth-child(2) {
    animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.75s both;
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    z-index: 1;
  }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scaleY(0.6);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line {
      animation: none;
    }

    .hero-logo,
    .hero-text-static .hero-tagline,
    .hero-text-static .hero-tagline::before,
    .hero-text-static .hero-tagline-line:nth-child(2) {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }

    .hero-logo {
      filter: drop-shadow(0 0 24px rgba(232, 255, 0, 0.15));
    }
  }
</style>
