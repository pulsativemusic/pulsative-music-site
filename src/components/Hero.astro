---
import HeroAnimation from './islands/HeroAnimation';
import ShowreelTeaser from './ShowreelTeaser.astro';
import type { Locale, Showreel, SiteSettings } from '../lib/types';
import { getUi, pickLocalized } from '../lib/i18n';

interface Props {
  settings: SiteSettings;
  locale: Locale;
  showreel?: Showreel | null;
}

const { settings, locale, showreel = null } = Astro.props;
const ui = getUi(locale);
const taglineLine1 = pickLocalized(settings.taglineLine1, locale);
const taglineLine2 = pickLocalized(settings.taglineLine2, locale);
---

<div
  class="home-hero-stack"
  style={settings.heroObjectPosition
    ? `--hero-object-position: ${settings.heroObjectPosition}`
    : undefined}
>
  <section class="hero">
    {
      settings.heroVideoUrl ? (
        <video
          class="hero-bg"
          src={settings.heroVideoUrl}
          autoplay
          muted
          loop
          playsinline
          poster={settings.heroImageUrl}
        />
      ) : (
        settings.heroImageUrl && (
          <img
            class="hero-bg"
            src={settings.heroImageUrl}
            alt=""
            fetchpriority="high"
            width={1920}
            height={1080}
          />
        )
      )
    }
    <div class="hero-overlay"></div>

    <div class="container hero-content">
      {
        settings.logoUrl ? (
          <img class="hero-logo" src={settings.logoUrl} alt={settings.bandName} width={320} height={120} />
        ) : (
          <HeroAnimation
            client:load
            bandName={settings.bandName}
            taglineLine1={taglineLine1}
            taglineLine2={taglineLine2}
          />
        )
      }

      {
        settings.logoUrl && (
          <div class="hero-text-static">
            <p class="hero-tagline">
              {taglineLine1 && <span class="hero-tagline-line">{taglineLine1}</span>}
              {taglineLine2 && <span class="hero-tagline-line">{taglineLine2}</span>}
            </p>
          </div>
        )
      }
    </div>

    {!showreel && (
      <div class="hero-scroll" aria-hidden="true">
        <span>{ui.home.scroll}</span>
        <div class="scroll-line"></div>
      </div>
    )}
  </section>

  {showreel && <ShowreelTeaser showreel={showreel} locale={locale} />}
</div>

<style>
  .home-hero-stack {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  .hero {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 75svh;
    min-height: 22rem;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--hero-object-position, center top);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(9, 9, 11, 0.35) 0%, rgba(9, 9, 11, 0.72) 100%),
      radial-gradient(ellipse at 20% 40%, rgba(232, 255, 0, 0.08), transparent 55%),
      radial-gradient(ellipse at 80% 60%, rgba(232, 255, 0, 0.04), transparent 50%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 100%;
    padding-block: var(--space-md);
  }

  .hero-logo {
    max-width: min(20rem, 70vw);
    height: auto;
    margin-bottom: var(--space-md);
    filter: drop-shadow(0 0 24px rgba(232, 255, 0, 0.15));
  }

  .hero-text-static .hero-tagline {
    font-size: clamp(0.95rem, 2.2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    max-width: 42rem;
    margin: 0;
    line-height: 1.55;
    padding-inline-start: 0.85rem;
    border-left: 2px solid rgba(232, 255, 0, 0.45);
  }

  .hero-text-static .hero-tagline-line {
    display: block;
  }

  .hero-scroll {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    z-index: 1;
  }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scaleY(0.6);
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-line {
      animation: none;
    }
  }
</style>
