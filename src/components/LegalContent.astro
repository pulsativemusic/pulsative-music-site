---
import type { LegalPage } from '../lib/types';
import { portableTextToHtml } from '../lib/portable-text';

interface Props {
  page: LegalPage;
}

const { page } = Astro.props;
const bodyHtml = portableTextToHtml(page.body);
---

<article class="legal-content" set:html={bodyHtml} />

<style>
  .legal-content {
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .legal-content :global(p),
  .legal-content :global(h2),
  .legal-content :global(h3),
  .legal-content :global(blockquote) {
    margin-bottom: var(--space-md);
  }

  .legal-content :global(h2),
  .legal-content :global(h3) {
    color: var(--color-text);
    line-height: 1.3;
  }

  .legal-content :global(h2) {
    font-size: 1.35rem;
    margin-top: var(--space-xl);
  }

  .legal-content :global(h3) {
    font-size: 1.1rem;
    margin-top: var(--space-lg);
  }

  .legal-content :global(p:first-child),
  .legal-content :global(h2:first-child),
  .legal-content :global(h3:first-child) {
    margin-top: 0;
  }

  .legal-content :global(strong) {
    font-weight: 700;
    color: var(--color-text);
  }

  .legal-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0 0 var(--space-md);
    padding-left: 1.25rem;
  }

  .legal-content :global(li) {
    margin-bottom: 0.35em;
  }
</style>
