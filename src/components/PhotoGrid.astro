---
import { pickLocalized } from '../lib/i18n';
import type { Locale, Photo } from '../lib/types';

interface Props {
  photos: Photo[];
  locale: Locale;
}

const { photos, locale } = Astro.props;
---

<div id="pswp-gallery" class="photo-grid" data-photo-masonry>
  {
    photos.length === 0 ? (
      <p class="empty text-muted">No photos yet.</p>
    ) : (
      photos.map((photo) => {
        const title = pickLocalized(photo.title, locale);
        const caption = photo.credit ? `${title} — ${photo.credit}` : title;

        return (
          <article class="photo-card reveal">
            <a
              class="photo-lightbox-link"
              href={photo.imageUrl}
              data-pswp-width={photo.width}
              data-pswp-height={photo.height}
              data-download-src={photo.originalUrl}
              data-download-filename={photo.downloadFilename ?? undefined}
              data-pswp-caption={caption}
              aria-label={title}
            >
              <div class="photo-frame">
                <img
                  src={photo.imageUrl}
                  alt={title}
                  loading="lazy"
                  width={photo.width}
                  height={photo.height}
                  style={photo.objectPosition ? { objectPosition: photo.objectPosition } : undefined}
                />
                <div class="photo-meta">
                  <h3>{title}</h3>
                  {photo.credit && <p class="photo-credit">{photo.credit}</p>}
                </div>
              </div>
            </a>
          </article>
        );
      })
    )
  }
</div>

<script>
  const observedGrids = new WeakSet<HTMLElement>();

  function layoutPhotoMasonry(grid: HTMLElement) {
    const styles = getComputedStyle(grid);
    const rowHeight = Number.parseFloat(styles.gridAutoRows) || 8;
    const gap = Number.parseFloat(styles.rowGap) || Number.parseFloat(styles.gap) || 0;

    grid.querySelectorAll<HTMLElement>('.photo-card').forEach((card) => {
      card.style.gridRowEnd = 'auto';
      const height = card.getBoundingClientRect().height;
      const span = Math.max(1, Math.ceil((height + gap) / (rowHeight + gap)));
      card.style.gridRowEnd = `span ${span}`;
    });

    grid.dataset.masonryLaidOut = 'true';
  }

  function initPhotoMasonry() {
    const grid = document.querySelector<HTMLElement>('[data-photo-masonry]');
    if (!grid || grid.querySelector('.empty')) return;

    const run = () => requestAnimationFrame(() => layoutPhotoMasonry(grid));

    const images = grid.querySelectorAll('img');
    let pending = images.length;

    const imageDone = () => {
      pending -= 1;
      if (pending <= 0) run();
    };

    images.forEach((img) => {
      if (img.complete) imageDone();
      else {
        img.addEventListener('load', imageDone, { once: true });
        img.addEventListener('error', imageDone, { once: true });
      }
    });

    if (pending === 0) run();

    if (observedGrids.has(grid)) return;
    observedGrids.add(grid);

    const resizeObserver = new ResizeObserver(run);
    grid.querySelectorAll('.photo-card').forEach((card) => resizeObserver.observe(card));
    window.addEventListener('resize', run, { passive: true });
  }

  initPhotoMasonry();
</script>

<style>
  .photo-grid {
    --photo-grid-gap: var(--space-md);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 8px;
    gap: var(--photo-grid-gap);
    align-items: start;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .photo-grid[data-masonry-laid-out='true'] {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .photo-card {
    min-width: 0;
  }

  .photo-lightbox-link {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: zoom-in;
  }

  .photo-lightbox-link:focus-visible {
    outline: 2px solid var(--color-accent, currentColor);
    outline-offset: 3px;
  }

  .photo-frame {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .photo-frame img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .photo-meta {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-md) var(--space-sm) var(--space-sm);
    background: linear-gradient(transparent, rgba(9, 9, 11, 0.92));
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  .photo-card:hover .photo-meta,
  .photo-card:focus-within .photo-meta {
    opacity: 1;
    transform: translateY(0);
  }

  .photo-meta h3 {
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .photo-credit {
    margin-top: 0.2rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .empty {
    grid-column: 1 / -1;
    opacity: 1;
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-grid {
      opacity: 1;
      transition: none;
    }

    .photo-meta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
