---
import { pickLocalized } from '../lib/i18n';
import type { Locale, Photo } from '../lib/types';

interface Props {
  photos: Photo[];
  locale: Locale;
}

const { photos, locale } = Astro.props;
---

<div class="photo-grid">
  {
    photos.map((photo) => (
      <article class="photo-card reveal">
        <div class="photo-frame">
          <img
            src={photo.imageUrl}
            alt={pickLocalized(photo.title, locale)}
            loading="lazy"
            width={900}
            height={1600}
          />
        </div>
        <h3>{pickLocalized(photo.title, locale)}</h3>
        {photo.credit && <p class="photo-credit text-muted">{photo.credit}</p>}
      </article>
    ))
  }
</div>

<style>
  .photo-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .photo-card h3 {
    margin-top: var(--space-sm);
    font-size: 1.1rem;
  }

  .photo-credit {
    margin-top: 0.25rem;
    font-size: 0.85rem;
  }

  .photo-frame {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .photo-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
