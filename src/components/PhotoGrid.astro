---
import { orientationClass } from '../lib/media';
import { pickLocalized } from '../lib/i18n';
import type { Locale, Photo } from '../lib/types';

interface Props {
  photos: Photo[];
  locale: Locale;
}

const { photos, locale } = Astro.props;
---

<div class="photo-grid">
  {
    photos.length === 0 ? (
      <p class="empty text-muted">No photos yet.</p>
    ) : (
      photos.map((photo) => {
        const orientation = orientationClass(photo.orientation);
        const isPortrait = orientation === 'portrait';

        return (
          <article class="photo-card reveal">
            <div class:list={['photo-frame', orientation]}>
              <img
                src={photo.imageUrl}
                alt={pickLocalized(photo.title, locale)}
                loading="lazy"
                width={isPortrait ? 900 : 1600}
                height={isPortrait ? 1600 : 900}
              />
            </div>
            <h3>{pickLocalized(photo.title, locale)}</h3>
            {photo.credit && <p class="photo-credit text-muted">{photo.credit}</p>}
          </article>
        );
      })
    )
  }
</div>

<style>
  .photo-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .photo-card h3 {
    margin-top: var(--space-sm);
    font-size: 1.1rem;
  }

  .photo-credit {
    margin-top: 0.25rem;
    font-size: 0.85rem;
  }

  .photo-frame {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .photo-frame.portrait {
    aspect-ratio: 9 / 16;
  }

  .photo-frame.landscape {
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 1024px) {
    .photo-card:has(.landscape) {
      grid-column: span 2;
    }
  }

  .photo-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty {
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
