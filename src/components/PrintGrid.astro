---
import type { PhotoPrint } from '../lib/types';
import { formatPrice } from '../lib/utils';

interface Props {
  prints: PhotoPrint[];
}

const { prints } = Astro.props;
---

{
  prints.length === 0 ? (
    <p class="empty text-muted">No prints available yet. Check back soon.</p>
  ) : (
    <div class="print-grid">
      {prints.map((print) => (
        <article class="print-card reveal">
          {print.imageUrl && (
            <div class="print-image">
              <img
                src={print.imageUrl}
                alt={print.title}
                loading="lazy"
                width={600}
                height={750}
              />
              {print.soldOut && <span class="sold-out">Sold Out</span>}
            </div>
          )}
          <div class="print-info">
            {print.category && (
              <p class="print-category">
                {print.category.charAt(0).toUpperCase() + print.category.slice(1)}
              </p>
            )}
            <h3>{print.title}</h3>
            {print.description && <p class="text-muted">{print.description}</p>}
            {print.sizes && print.sizes.length > 0 && (
              <p class="print-sizes">Sizes: {print.sizes.join(', ')}</p>
            )}
            <div class="print-footer">
              <span class="print-price">{formatPrice(print.price, print.currency)}</span>
              {print.purchaseUrl && !print.soldOut ? (
                <a
                  href={print.purchaseUrl}
                  class="btn btn-primary"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Buy Print
                </a>
              ) : (
                <span class="btn btn-outline disabled">Unavailable</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )
}

<style>
  .print-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .print-card {
    display: grid;
    gap: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .print-card:hover {
    border-color: rgba(230, 57, 70, 0.4);
  }

  .print-image {
    position: relative;
    overflow: hidden;
  }

  .print-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .print-card:hover .print-image img {
    transform: scale(1.03);
  }

  .sold-out {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 0.25rem 0.6rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .print-info {
    padding: 0 var(--space-md) var(--space-md);
    display: grid;
    gap: var(--space-xs);
  }

  .print-category {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
  }

  .print-info h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .print-sizes {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .print-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .print-price {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
  }

  .btn-primary {
    padding: 0.5rem 1rem;
    font-size: 0.7rem;
  }

  .btn.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  .empty {
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
