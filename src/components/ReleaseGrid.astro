---
import type { Release } from '../lib/types';
import { formatShortDate } from '../lib/utils';

interface Props {
  releases: Release[];
}

const { releases } = Astro.props;
const latest = releases[0];
---

<section class="music-section">
  {
    latest?.youtubeId && (
      <div class="video-embed reveal">
        <iframe
          src={`https://www.youtube.com/embed/${latest.youtubeId}`}
          title={`${latest.title} video`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="release-grid">
    {
      releases.map((release) => (
        <article class="release-card reveal">
          {release.coverUrl && (
            <img
              src={release.coverUrl}
              alt={`${release.title} cover`}
              loading="lazy"
              width={300}
              height={300}
            />
          )}
          <div class="release-info">
            <h3>{release.title}</h3>
            <p class="text-muted">{formatShortDate(release.releaseDate)}</p>
            <div class="release-links">
              {release.spotifyUrl && (
                <a href={release.spotifyUrl} target="_blank" rel="noopener noreferrer">
                  Spotify
                </a>
              )}
              {release.appleUrl && (
                <a href={release.appleUrl} target="_blank" rel="noopener noreferrer">
                  Apple Music
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .video-embed {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .release-card {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .release-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .release-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .release-links {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .release-links a {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .release-links a:hover {
    color: var(--color-accent-hover);
  }
</style>
