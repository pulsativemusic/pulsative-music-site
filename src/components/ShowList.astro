---
import type { Locale, Show } from '../lib/types';
import { getUi } from '../lib/i18n';
import { formatShowDate } from '../lib/utils';
import Button from './Button.astro';

interface Props {
  shows: Show[];
  compact?: boolean;
  locale?: Locale;
}

const { shows, compact = false, locale = 'de' } = Astro.props;
const ui = getUi(locale);
---

{
  shows.length === 0 ? (
    <p class="empty text-muted">—</p>
  ) : (
    <ul class:list={['show-list', { compact }]}>
      {shows.map((show) => (
        <li class="show-item">
          <div class="show-date">
            <time datetime={show.date}>{formatShowDate(show.date)}</time>
          </div>
          <div class="show-details">
            <h3 class="show-venue">{show.venue}</h3>
            <p class="show-location text-muted">
              {show.city}, {show.country}
            </p>
            {show.description && !compact && (
              <p class="show-description">{show.description}</p>
            )}
          </div>
          <div class="show-action">
            {show.soldOut ? (
              <span class="sold-out">{ui.misc.soldOut}</span>
            ) : show.ticketUrl ? (
              <Button
                href={show.ticketUrl}
                variant="primary"
                size="sm"
                target="_blank"
                rel="noopener noreferrer"
              >
                {ui.misc.tickets}
              </Button>
            ) : (
              <span class="text-muted">TBA</span>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .show-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .show-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .show-item:hover {
    border-color: var(--color-accent-hover-border);
    box-shadow: var(--shadow-glow);
  }

  @media (min-width: 640px) {
    .show-item {
      grid-template-columns: 11rem 1fr auto;
      align-items: center;
    }
  }

  .show-date time {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .show-venue {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .show-location {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .show-description {
    margin-top: var(--space-sm);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .sold-out {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .compact .show-description {
    display: none;
  }

  .compact .show-item {
    padding: var(--space-md) var(--space-lg);
  }

  .empty {
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
