---
import type { Locale, Show } from '../lib/types';
import { getUi } from '../lib/i18n';
import { formatShowDate, formatShowTime } from '../lib/utils';
import Button from './Button.astro';

interface Props {
  shows: Show[];
  compact?: boolean;
  /** Past archive: no ticket CTA, muted look so they don’t read as bookable. */
  past?: boolean;
  locale?: Locale;
}

const { shows, compact = false, past = false, locale = 'de' } = Astro.props;
const ui = getUi(locale);
---

{
  shows.length === 0 ? (
    <p class="empty text-muted">—</p>
  ) : (
    <ul class:list={['show-list', { compact, past }]}>
      {shows.map((show) => {
        const datetime = show.time ? `${show.date}T${show.time}` : show.date;
        return (
          <li class="show-item">
            <div class="show-date">
              <time datetime={datetime}>
                <span class="show-date-day">{formatShowDate(show.date, locale)}</span>
                {show.time && !past && (
                  <span class="show-date-time">{formatShowTime(show.time, locale)}</span>
                )}
              </time>
            </div>
            <div class="show-details">
              <h3 class="show-venue">{show.venue}</h3>
              <p class="show-location text-muted">
                {show.city}, {show.country}
              </p>
              {show.description && !compact && (
                <p class="show-description">{show.description}</p>
              )}
            </div>
            {
              !past && (
                <div class="show-action">
                  {show.soldOut ? (
                    <span class="sold-out">{ui.misc.soldOut}</span>
                  ) : show.ticketUrl ? (
                    <Button
                      href={show.ticketUrl}
                      variant="primary"
                      size="sm"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {ui.misc.tickets}
                    </Button>
                  ) : (
                    <span class="text-muted">TBA</span>
                  )}
                </div>
              )
            }
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .show-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .show-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .show-item:hover {
    border-color: var(--color-accent-hover-border);
    box-shadow: var(--shadow-glow);
  }

  @media (min-width: 640px) {
    .show-item {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'date action'
        'details details';
      align-items: start;
      column-gap: var(--space-md);
      row-gap: var(--space-sm);
    }

    .show-date {
      grid-area: date;
    }

    .show-action {
      grid-area: action;
      justify-self: end;
    }

    .show-details {
      grid-area: details;
    }
  }

  .show-details {
    min-width: 0;
  }

  .show-date time {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .show-date-time {
    letter-spacing: 0.04em;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }

  .show-venue {
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.25rem);
    line-height: 1.25;
    margin-bottom: 0.35rem;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .show-location {
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .show-description {
    margin-top: var(--space-sm);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .sold-out {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .compact .show-description {
    display: none;
  }

  .compact .show-item {
    padding: var(--space-md) var(--space-lg);
  }

  /* Archive cards: date + venue only, no CTA, no “live” accent */
  .past .show-item {
    background: transparent;
    border-style: dashed;
    box-shadow: none;
  }

  .past .show-item:hover {
    border-color: var(--color-border);
    box-shadow: none;
  }

  .past .show-date time {
    color: var(--color-text-muted);
  }

  .past .show-venue {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .past .show-item {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'date details';
      align-items: baseline;
      column-gap: var(--space-lg);
    }
  }

  .empty {
    padding: var(--space-lg);
    text-align: center;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
