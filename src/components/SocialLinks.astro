const links = socials?.length ? socials : [];
---

<nav class:list={['social-links', className]} aria-label="Social media">
  {
    links.map((social) => {
      const icon = iconFor(social.platform, social.url);

      return (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`social-link social-${icon}`}
          aria-label={social.platform}
        >
          {
            iconPaths[icon] ? (
              <svg
                class="social-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={iconPaths[icon]} />
              </svg>
            ) : (
              <span class="social-label">{social.platform}</span>
            )
          }
        </a>
      );
    })
  }
</nav>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    padding: 0.45rem;
    border: none;
    border-radius: var(--radius-sm);
    line-height: 0;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .social-icon {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .social-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    padding-inline: 0.2rem;
  }

  .social-link:hover {
    color: var(--color-accent);
  }
</style>
