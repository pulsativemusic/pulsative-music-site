---
import { orientationClass } from '../lib/media';
import { pickLocalized } from '../lib/i18n';
import type { Locale, Video } from '../lib/types';

interface Props {
  videos: Video[];
  locale: Locale;
}

const { videos, locale } = Astro.props;
const playableVideos = videos.filter((video) => video.vimeoId?.trim());
---

{
  playableVideos.length > 0 && (
    <div class="video-grid">
      {playableVideos.map((video) => {
        const orientation = orientationClass(video.orientation);
        const vimeoId = video.vimeoId.trim();

        return (
          <article class="video-card reveal">
            <div class:list={['video-embed', orientation]}>
              <iframe
                src={`https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0`}
                title={pickLocalized(video.title, locale)}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                allowfullscreen
              />
            </div>
            <h3>{pickLocalized(video.title, locale)}</h3>
          </article>
        );
      })}
    </div>
  )
}

<style>
  .video-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 640px) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .video-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .video-card h3 {
    margin-top: var(--space-sm);
    font-size: 1.1rem;
  }

  .video-embed {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-embed.portrait {
    aspect-ratio: 9 / 16;
  }

  .video-embed.landscape {
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 1024px) {
    .video-card:has(.landscape) {
      grid-column: span 2;
    }
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
