---
import type { Locale, SiteSettings } from '../../lib/types';
import { isAnnouncementBannerVisible } from '../../lib/data';
import { getUi, pickLocalized } from '../../lib/i18n';

interface Props {
  settings: SiteSettings;
  locale: Locale;
}

const { settings, locale } = Astro.props;

if (!isAnnouncementBannerVisible(settings, locale)) {
  return null;
}

const ui = getUi(locale);
const message = pickLocalized(settings.announcementMessage, locale);
const linkLabel =
  pickLocalized(settings.announcementLinkLabel, locale) || ui.announcement.learnMore;
const link = settings.announcementLink?.trim();
---

<div class="announcement" role="region" aria-label={ui.announcement.label}>
  <div class="announcement-marquee">
    <template data-announcement-template>
      <span class="announcement-segment">
        <span class="announcement-message">{message}</span>
        {
          link && (
            <a href={link} class="announcement-link">
              {linkLabel}
            </a>
          )
        }
      </span>
    </template>

    <div class="announcement-viewport">
      <div class="announcement-track" data-announcement-track>
        <div class="announcement-group" data-announcement-group></div>
      </div>
    </div>
  </div>

  <div class="announcement-static">
    <p class="announcement-message">{message}</p>
    {
      link && (
        <a href={link} class="announcement-link">
          {linkLabel}
        </a>
      )
    }
  </div>
</div>

<script>
  let scrollAbort: AbortController | undefined;
  let marqueeRaf = 0;
  let marqueeOffset = 0;
  let marqueeDirection = 1;
  let lastFrameTime = 0;

  const cloneSegment = (template: HTMLTemplateElement) => {
    return template.content.firstElementChild!.cloneNode(true) as HTMLElement;
  };

  const disableSegmentLinks = (root: ParentNode) => {
    root.querySelectorAll<HTMLAnchorElement>('.announcement-link').forEach((anchor) => {
      anchor.tabIndex = -1;
    });
  };

  const stopMarquee = () => {
    if (marqueeRaf) {
      cancelAnimationFrame(marqueeRaf);
      marqueeRaf = 0;
    }
    lastFrameTime = 0;
  };

  const setupAnnouncementMarquee = (announcement: HTMLElement) => {
    const viewport = announcement.querySelector<HTMLElement>('.announcement-viewport');
    const track = announcement.querySelector<HTMLElement>('[data-announcement-track]');
    const group = announcement.querySelector<HTMLElement>('[data-announcement-group]');
    const template = announcement.querySelector<HTMLTemplateElement>(
      '[data-announcement-template]',
    );

    if (!viewport || !track || !group || !template?.content.firstElementChild) {
      return;
    }

    stopMarquee();
    track.getAnimations().forEach((animation) => animation.cancel());

    group.replaceChildren(cloneSegment(template));

    let copies = 1;
    while (group.scrollWidth < viewport.clientWidth && copies < 24) {
      group.appendChild(cloneSegment(template));
      copies += 1;
    }

    group.appendChild(cloneSegment(template));

    const cloneGroup = group.cloneNode(true) as HTMLElement;
    cloneGroup.setAttribute('aria-hidden', 'true');
    disableSegmentLinks(cloneGroup);
    track.replaceChildren(group, cloneGroup);

    const loopWidth = Math.round(group.getBoundingClientRect().width);
    if (loopWidth <= 0) {
      return;
    }

    const pixelsPerSecond = 72;
    marqueeOffset = ((marqueeOffset % loopWidth) + loopWidth) % loopWidth;
    marqueeDirection = 1;
    track.style.transform = `translate3d(${-marqueeOffset}px, 0, 0)`;

    // Modular rAF — never finishes; reverse is just a sign flip (no WAAPI timeline edge)
    const tick = (now: number) => {
      if (lastFrameTime) {
        const deltaSeconds = Math.min((now - lastFrameTime) / 1000, 0.064);
        marqueeOffset =
          (((marqueeOffset + marqueeDirection * pixelsPerSecond * deltaSeconds) % loopWidth) +
            loopWidth) %
          loopWidth;
        track.style.transform = `translate3d(${-marqueeOffset}px, 0, 0)`;
      }
      lastFrameTime = now;
      marqueeRaf = requestAnimationFrame(tick);
    };

    marqueeRaf = requestAnimationFrame(tick);
  };

  const initAnnouncementMarquee = () => {
    scrollAbort?.abort();
    stopMarquee();

    const announcement = document.querySelector<HTMLElement>('.announcement');
    if (!announcement) {
      return;
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    setupAnnouncementMarquee(announcement);

    let lastScrollY = window.scrollY;
    scrollAbort = new AbortController();

    window.addEventListener(
      'scroll',
      () => {
        const currentScrollY = window.scrollY;
        const delta = currentScrollY - lastScrollY;

        if (Math.abs(delta) < 2) {
          return;
        }

        marqueeDirection = delta < 0 ? -1 : 1;
        lastScrollY = currentScrollY;
      },
      { passive: true, signal: scrollAbort.signal },
    );
  };

  document.addEventListener('astro:page-load', initAnnouncementMarquee);
  initAnnouncementMarquee();
</script>

<style>
  .announcement {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    z-index: 99;
    display: flex;
    align-items: center;
    min-height: var(--announcement-banner-height);
    background: var(--color-accent-muted);
    border-bottom: 1px solid var(--color-accent-hover-border);
  }

  .announcement-marquee {
    display: block;
    width: 100%;
  }

  .announcement-static {
    display: none;
    width: 100%;
  }

  .announcement-viewport {
    overflow: hidden;
    width: 100%;
  }

  .announcement-track {
    display: flex;
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .announcement-group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
  }

  .announcement-segment {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding-inline: 2.5rem;
    flex-shrink: 0;
  }

  .announcement-segment::after {
    content: '◆';
    font-size: 0.45rem;
    color: var(--color-accent);
    opacity: 0.85;
  }

  .announcement-message {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.4;
    color: var(--color-text);
    white-space: nowrap;
  }

  .announcement-link {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .announcement-link:hover {
    color: var(--color-accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-marquee {
      display: none;
    }

    .announcement-static {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
