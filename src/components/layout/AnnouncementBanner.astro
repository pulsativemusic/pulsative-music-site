---
import type { Locale, SiteSettings } from '../../lib/types';
import { isAnnouncementBannerVisible } from '../../lib/data';
import { getUi, pickLocalized } from '../../lib/i18n';

interface Props {
  settings: SiteSettings;
  locale: Locale;
}

const { settings, locale } = Astro.props;

if (!isAnnouncementBannerVisible(settings, locale)) {
  return null;
}

const ui = getUi(locale);
const message = pickLocalized(settings.announcementMessage, locale);
const linkLabel =
  pickLocalized(settings.announcementLinkLabel, locale) || ui.announcement.learnMore;
const link = settings.announcementLink?.trim();
---

<div class="announcement" role="region" aria-label={ui.announcement.label}>
  <div class="container announcement-inner">
    <p class="announcement-message">{message}</p>
    {
      link && (
        <a href={link} class="announcement-link">
          {linkLabel}
        </a>
      )
    }
  </div>
</div>

<style>
  .announcement {
    background: var(--color-accent-muted);
    border-bottom: 1px solid var(--color-accent-hover-border);
  }

  .announcement-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding-block: 0.75rem;
    text-align: center;
  }

  .announcement-message {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
  }

  .announcement-link {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-on-accent);
    background: var(--color-accent);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  .announcement-link:hover {
    background: var(--color-accent-hover);
  }
</style>
