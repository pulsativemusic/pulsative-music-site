---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AnnouncementBanner from './AnnouncementBanner.astro';
import CookieConsent from '../CookieConsent.astro';
import type { SiteSettings } from '../../lib/types';
import type { Locale } from '../../lib/types';
import { isAnnouncementBannerVisible } from '../../lib/data';
import {
  getLocaleFromPath,
  localizedPath,
  pickLocalized,
  switchLocalePath,
} from '../../lib/i18n';
import {
  absoluteUrl,
  buildMusicGroupJsonLd,
  buildPageTitle,
  buildWebPageJsonLd,
  getSiteUrl,
  ogLocale,
  resolveAssetUrl,
  resolvePageDescription,
} from '../../lib/seo';

interface Props {
  title?: string;
  description?: string;
  settings: SiteSettings;
  noindex?: boolean;
}

const { title, description, settings, noindex = false } = Astro.props;
const locale = (Astro.currentLocale ?? getLocaleFromPath(Astro.url.pathname)) as Locale;
const alternateLocale: Locale = locale === 'de' ? 'en' : 'de';
const siteUrl = getSiteUrl(Astro.site?.href.replace(/\/$/, ''));
const canonicalPath = Astro.url.pathname;
const canonicalUrl = absoluteUrl(canonicalPath === '/' ? '' : canonicalPath, siteUrl);
const alternateUrl = absoluteUrl(switchLocalePath(canonicalPath, alternateLocale), siteUrl);
const isHome = canonicalPath === '/' || canonicalPath === '/en' || canonicalPath === '/en/';
const pageTitle = buildPageTitle(title, settings.bandName);
const pageDescription = resolvePageDescription(description, settings, locale, isHome);
const ogImageUrl = resolveAssetUrl(settings.heroImageUrl, siteUrl);
const ogImageAlt = `${settings.bandName} — ${pickLocalized(settings.tagline, locale)}`;
const jsonLd = isHome
  ? buildMusicGroupJsonLd({ settings, siteUrl, description: pageDescription, locale })
  : buildWebPageJsonLd(siteUrl, canonicalUrl, pageTitle, pageDescription);
const jsonLdSerialized = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#09090b" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath('/', 'de'), siteUrl)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={settings.bandName} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(alternateLocale)} />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:alt" content={ogImageAlt} />
          <meta property="og:image:width" content="1024" />
          <meta property="og:image:height" content="571" />
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/michroma/v21/PN_zRfy9qWD8fEagAPg9pTn5_PDb.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="https://fonts.gstatic.com/s/dmsans/v17/rP2Yp2ywxg089UriI5-g4vlH9VoD8Cmcqbu0-K6z9mXg.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={jsonLdSerialized} />
    <ClientRouter />
  </head>
  <body>
    <Header settings={settings} />
    {isAnnouncementBannerVisible(settings, locale) && (
      <AnnouncementBanner settings={settings} locale={locale} />
    )}
    <main>
      <slot />
    </main>
    <Footer settings={settings} />
    <CookieConsent locale={locale} />
  </body>
</html>

<style>
  main {
    padding-top: var(--announcement-banner-height);
    min-height: calc(100vh - var(--header-height) - var(--announcement-banner-height) - 12rem);
  }
</style>
