---
import type { SiteSettings } from '../../lib/types';
import type { Locale } from '../../lib/types';
import {
  getLocaleFromPath,
  getUi,
  pathFor,
  pickLocalized,
} from '../../lib/i18n';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const locale = (Astro.currentLocale ?? getLocaleFromPath(Astro.url.pathname)) as Locale;
const ui = getUi(locale);
const year = new Date().getFullYear();
const tagline = pickLocalized(settings.tagline, locale);
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-kicker">{ui.footer.official}</p>
      <p class="footer-name">{settings.bandName}</p>
      <p class="footer-tagline text-muted">{tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <p class="footer-links-label">{ui.footer.follow}</p>
      <SocialLinks socials={settings.socials} />
    </nav>

    <nav class="footer-legal" aria-label="Legal links">
      <p class="footer-links-label">{ui.footer.legal}</p>
      <div class="footer-links">
        <a href={pathFor('impressum', locale)}>{ui.legal.impressum}</a>
        <a href={pathFor('privacy', locale)}>{ui.legal.privacy}</a>
        <a href={pathFor('contact', locale)}>{ui.footer.contact}</a>
      </div>
    </nav>

    <div class="footer-meta">
      <p class="footer-copy text-muted">
        &copy; {year} {settings.bandName}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .footer-kicker {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xs);
  }

  .footer-tagline {
    margin-bottom: 0;
    max-width: 36ch;
  }

  .footer-links-label {
    margin-bottom: var(--space-sm);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .footer-links a {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    font-size: 0.78rem;
    margin-bottom: 0;
  }

  .footer-meta {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 50rem) {
    .footer-inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-lg) var(--space-xl);
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }
</style>
