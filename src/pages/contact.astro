---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
---

<BaseLayout title="Contact" description={`Contact ${settings.bandName}`} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">Get in Touch</p>
      <h1 class="page-title reveal reveal-delay-1">Contact</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">
        Booking, press, and general inquiries.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-block reveal">
        <h2 class="block-title">Booking</h2>
        <a href={`mailto:${settings.bookingEmail}`} class="contact-link">
          {settings.bookingEmail}
        </a>
      </div>

      <div class="contact-block reveal reveal-delay-1">
        <h2 class="block-title">Social</h2>
        <ul class="social-list">
          {
            settings.socials.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noopener noreferrer">
                  {social.platform}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="contact-block reveal reveal-delay-2">
        <h2 class="block-title">Send a Message</h2>
        <form
          class="contact-form"
          action="https://formspree.io/f/your-form-id"
          method="POST"
        >
          <label>
            <span>Name</span>
            <input type="text" name="name" required />
          </label>
          <label>
            <span>Email</span>
            <input type="email" name="email" required />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="5" required></textarea>
          </label>
          <Button type="submit" variant="primary">Send</Button>
        </form>
        <p class="form-note text-muted">
          Replace the Formspree action URL in <code>contact.astro</code> with your own form endpoint.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }

    .contact-block:last-child {
      grid-column: 1 / -1;
    }
  }

  .block-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .contact-link {
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-sm);
  }

  .social-list a {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .social-list a:hover {
    color: var(--color-accent);
  }

  .contact-form {
    display: grid;
    gap: var(--space-md);
    max-width: 32rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.35rem;
  }

  .contact-form span {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-form input,
  .contact-form textarea {
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .form-note {
    margin-top: var(--space-sm);
    font-size: 0.8rem;
  }

  code {
    font-size: 0.85em;
    color: var(--color-accent);
  }
</style>
