---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getPhotos, getSiteSettings } from '../../lib/data';
import { getUi, pickLocalized } from '../../lib/i18n';

const locale = 'en';
const settings = await getSiteSettings();
const photos = await getPhotos();
const ui = getUi(locale);
const intro = pickLocalized(settings.fotosIntro, locale);
---

<BaseLayout title={ui.fotos.title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">{ui.fotos.kicker}</p>
      <h1 class="page-title reveal reveal-delay-1">{ui.fotos.title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-2">{intro}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <PhotoGrid photos={photos} locale={locale} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }
</style>
