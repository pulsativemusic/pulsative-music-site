---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ShowList from '../../components/ShowList.astro';
import Button from '../../components/Button.astro';
import {
  getPastShows,
  getSiteSettings,
  getUpcomingShows,
  isLivePageEnabled,
} from '../../lib/data';
import { getUi, localizedPath, pickLocalized } from '../../lib/i18n';

const locale = 'en';
const settings = await getSiteSettings();

if (!isLivePageEnabled(settings)) {
  return Astro.redirect(localizedPath('/', locale));
}

const ui = getUi(locale);
const upcomingShows = await getUpcomingShows();
const pastShows = await getPastShows();
const intro = pickLocalized(settings.liveIntro, locale);
---

<BaseLayout title={ui.live.title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">{ui.live.kicker}</p>
      <h1 class="page-title reveal reveal-delay-1">{ui.live.title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-2">{intro}</p>}
      <Button href={localizedPath('/live/calendar.ics', locale)} variant="outline" class="reveal reveal-delay-3">
        {ui.live.calendar}
      </Button>
    </div>
  </section>

  <section class="section shows-section">
    <div class="container">
      <header class="shows-section-header reveal">
        <h2 class="section-title">{ui.live.upcoming}</h2>
      </header>
      <ShowList shows={upcomingShows} locale={locale} />
    </div>
  </section>

  {
    pastShows.length > 0 && (
      <section class="section section-alt shows-section">
        <div class="container">
          <header class="shows-section-header reveal">
            <h2 class="section-title">{ui.live.past}</h2>
          </header>
          <ShowList shows={pastShows} compact locale={locale} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: var(--space-lg);
  }

  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
    margin-bottom: var(--space-lg);
  }

  .shows-section {
    padding-block: var(--space-2xl);
  }

  .shows-section-header {
    margin-bottom: var(--space-xl);
  }

  .shows-section .section-title {
    line-height: 1.1;
  }

  .section-alt {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
  }
</style>
