---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ShowList from '../components/ShowList.astro';
import Button from '../components/Button.astro';
import { getSiteSettings, getUpcomingShows, isHomepageUpcomingDatesEnabled, isLivePageEnabled } from '../lib/data';
import { getUi, localizedPath } from '../lib/i18n';
import { getShowreelFromSettings } from '../lib/showreel';

const locale = 'de';
const settings = await getSiteSettings();
const upcomingShows = await getUpcomingShows(3);
const ui = getUi(locale);
const showreel = getShowreelFromSettings(settings);
---

<BaseLayout settings={settings}>
  <Hero settings={settings} locale={locale} showreel={showreel} />

  {
    isHomepageUpcomingDatesEnabled(settings) &&
    upcomingShows.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-header reveal">
            <div>
              <p class="section-kicker">{ui.home.upcomingShows}</p>
              <h2 class="section-title">{ui.nav.live}</h2>
            </div>
            {
              isLivePageEnabled(settings) && (
                <Button href={localizedPath('/live', locale)} variant="outline">
                  {ui.home.allDates}
                </Button>
              )
            }
          </div>
          <ShowList shows={upcomingShows} compact locale={locale} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .section-alt {
    background: var(--color-bg-elevated);
    border-block: 1px solid var(--color-border);
  }
</style>
