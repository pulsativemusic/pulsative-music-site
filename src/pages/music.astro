---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ReleaseGrid from '../components/ReleaseGrid.astro';
import { getReleases, getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
const releases = await getReleases();
---

<BaseLayout title="Music" description={`Music by ${settings.bandName}`} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">Discography</p>
      <h1 class="page-title reveal reveal-delay-1">Music</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">
        Stream the latest releases and watch the videos.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ReleaseGrid releases={releases} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: 0;
  }

  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }
</style>
