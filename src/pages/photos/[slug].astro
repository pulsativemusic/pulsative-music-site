---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PhotoLightbox from '../../components/islands/PhotoLightbox';
import { getGalleryBySlug, getGalleries, getSiteSettings } from '../../lib/data';
import { formatShortDate } from '../../lib/utils';

export async function getStaticPaths() {
  const galleries = await getGalleries();
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
  }));
}

const { slug } = Astro.params;
const settings = await getSiteSettings();
const gallery = slug ? await getGalleryBySlug(slug) : null;

if (!gallery) {
  return Astro.redirect('/photos');
}

const lightboxImages = gallery.photos
  .filter((photo) => photo.imageUrl)
  .map((photo, index) => ({
    id: photo._key ?? `photo-${index}`,
    src: photo.imageUrl!,
    width: photo.width ?? 1200,
    height: photo.height ?? 800,
    alt: photo.caption,
    caption: photo.caption,
  }));
---

<BaseLayout
  title={gallery.title}
  description={`Photos from ${gallery.title}`}
  settings={settings}
>
  <section class="page-hero section">
    <div class="container">
      <a href="/photos" class="back-link">← All Galleries</a>
      <h1 class="page-title reveal">{gallery.title}</h1>
      <p class="page-meta text-muted reveal reveal-delay-1">
        {gallery.showDate && formatShortDate(gallery.showDate)}
        {gallery.venue && ` — ${gallery.venue}`}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <PhotoLightbox client:visible images={lightboxImages} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: 0;
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .page-title {
    font-size: clamp(2rem, 8vw, 4rem);
    margin-bottom: var(--space-xs);
  }
</style>
