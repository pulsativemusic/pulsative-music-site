---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import { getGalleries, getSiteSettings } from '../../lib/data';

const settings = await getSiteSettings();
const galleries = await getGalleries();
---

<BaseLayout title="Photos" description={`Live photos from ${settings.bandName}`} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">Live</p>
      <h1 class="page-title reveal reveal-delay-1">Photos</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">
        Galleries from shows, festivals, and behind the scenes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <GalleryGrid galleries={galleries} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: 0;
  }

  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }
</style>
