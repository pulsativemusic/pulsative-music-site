---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getPressAssets, getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
const assets = await getPressAssets();
---

<BaseLayout title="Press" description={`Press kit for ${settings.bandName}`} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">Media</p>
      <h1 class="page-title reveal reveal-delay-1">Press Kit</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">
        Download logos, photos, and bio materials for press and booking.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="press-grid">
        {
          assets.map((asset) => (
            <article class="press-card reveal">
              <span class="press-type">{asset.assetType}</span>
              <h3>{asset.title}</h3>
              {asset.description && <p class="text-muted">{asset.description}</p>}
              {asset.fileUrl ? (
                <a href={asset.fileUrl} class="btn btn-outline" download>
                  Download
                </a>
              ) : (
                <span class="text-muted">Coming soon</span>
              )}
            </article>
          ))
        }
      </div>

      <div class="press-contact reveal">
        <h2 class="section-title">Booking & Press</h2>
        <p class="text-muted">
          For interviews, press requests, and booking inquiries:
        </p>
        <a href={`mailto:${settings.bookingEmail}`} class="contact-email">
          {settings.bookingEmail}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }

  .press-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .press-card {
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .press-type {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .press-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .press-card .btn {
    margin-top: var(--space-md);
  }

  .press-contact {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .contact-email {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  .contact-email:hover {
    color: var(--color-accent-hover);
  }
</style>
