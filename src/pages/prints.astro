---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PrintGrid from '../components/PrintGrid.astro';
import { getPhotoPrints, getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
const prints = await getPhotoPrints();
---

<BaseLayout
  title="Prints"
  description={`Fine art photography prints by ${settings.bandName}, based in Cologne.`}
  settings={settings}
>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">Photography</p>
      <h1 class="page-title reveal reveal-delay-1">Prints</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">
        Limited-edition fine art prints shot by Marco in Cologne and on the road.
        Each print is produced on archival paper and shipped worldwide.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <PrintGrid prints={prints} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: 0;
  }

  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 40rem;
    line-height: 1.7;
  }
</style>
