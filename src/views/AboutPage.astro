---
import BaseLayout from '../components/layout/BaseLayout.astro';
import AboutSections from '../components/AboutContent.astro';
import { getAboutContent, getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'about')) {
  return Astro.redirect(pathFor('home', locale));
}

const about = await getAboutContent(locale);
const ui = getUi(locale);
---

<BaseLayout title={ui.about.title} description={ui.seo.about} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <AboutSections about={about} bandName={settings.bandName} title={ui.about.title} ui={ui.about} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-height) - var(--announcement-banner-height));
    padding-block: var(--space-lg);
    box-sizing: border-box;
  }
</style>
