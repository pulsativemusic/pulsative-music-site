---
import BaseLayout from '../components/layout/BaseLayout.astro';
import AboutSections from '../components/AboutContent.astro';
import { getAboutContent, getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'about')) {
  return Astro.redirect(pathFor('home', locale));
}

const about = await getAboutContent(locale);
const ui = getUi(locale);
---

<BaseLayout title={ui.about.title} description={ui.seo.about} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{ui.about.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <AboutSections about={about} bandName={settings.bandName} ui={ui.about} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
  }
</style>
