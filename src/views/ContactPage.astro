---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'contact')) {
  return Astro.redirect(pathFor('home', locale));
}

const ui = getUi(locale);
const contactImageUrl = settings.contactImageUrl;
---

<BaseLayout title={ui.contact.title} description={ui.contact.intro} settings={settings}>
  <section class="page-hero section">
    <div class:list={['container', 'contact-split', { 'has-photo': Boolean(contactImageUrl) }]}>
      <div class="contact-copy">
        <h1 class="page-title reveal">{ui.contact.title}</h1>
        <p class="page-intro text-muted reveal reveal-delay-1">{ui.contact.intro}</p>

        <div class="contact-details">
          <div class="contact-block reveal reveal-delay-1">
            <h2 class="block-title">{ui.contact.booking}</h2>
            {settings.bookingContactName && <p class="contact-name">{settings.bookingContactName}</p>}
            <a href={`mailto:${settings.bookingEmail}`} class="contact-link">
              {settings.bookingEmail}
            </a>
          </div>

          {
            settings.phone && (
              <div class="contact-block reveal reveal-delay-2">
                <h2 class="block-title">{ui.contact.phone}</h2>
                <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="contact-link">
                  {settings.phone}
                </a>
              </div>
            )
          }
        </div>
      </div>

      {
        contactImageUrl && (
          <img
            class="contact-photo reveal reveal-delay-1"
            src={contactImageUrl}
            alt={settings.bandName}
            loading="eager"
            width={1200}
            height={800}
          />
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-md) var(--space-xl);
  }

  .contact-split {
    display: grid;
    gap: var(--space-lg);
  }

  .contact-copy {
    min-width: 0;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
    margin-bottom: var(--space-lg);
  }

  .contact-details {
    display: grid;
    gap: var(--space-lg);
  }

  .block-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .contact-name {
    margin-bottom: var(--space-xs);
    color: var(--color-text-muted);
  }

  .contact-link {
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .contact-link:hover {
    color: var(--color-accent-hover);
  }

  .contact-photo {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 20rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .contact-split.has-photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .page-title {
      font-size: clamp(2.25rem, 3.5vw, 3.75rem);
    }

    .contact-photo {
      max-height: 22rem;
    }
  }
</style>
