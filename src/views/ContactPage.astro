---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'contact')) {
  return Astro.redirect(pathFor('home', locale));
}

const ui = getUi(locale);
const title = pickLocalized(settings.contactTitle, locale) || ui.contact.title;
const contactImageUrl = settings.contactImageUrl;
---

<BaseLayout title={title} description={ui.contact.intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <div class:list={['contact-split', { 'has-photo': Boolean(contactImageUrl) }]}>
        <div class="contact-copy">
          <h1 class="page-title reveal">{title}</h1>
          <p class="page-intro text-muted reveal reveal-delay-1">{ui.contact.intro}</p>

          <div class="contact-block reveal reveal-delay-1">
            <h2 class="section-title">{ui.contact.booking}</h2>
            {settings.bookingContactName && <p class="contact-name">{settings.bookingContactName}</p>}
            <a href={`mailto:${settings.bookingEmail}`} class="contact-link">
              {settings.bookingEmail}
            </a>
          </div>

          {
            settings.phone && (
              <div class="contact-block reveal reveal-delay-2">
                <h2 class="section-title">{ui.contact.phone}</h2>
                <a href={`tel:${settings.phone.replace(/\s/g, '')}`} class="contact-link">
                  {settings.phone}
                </a>
              </div>
            )
          }
        </div>

        {
          contactImageUrl && (
            <img
              class="contact-photo reveal reveal-delay-1"
              src={contactImageUrl}
              alt={settings.bandName}
              loading="eager"
              width={1200}
              height={800}
            />
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-height) - var(--announcement-banner-height));
    padding-block: var(--space-lg);
    box-sizing: border-box;
  }

  .contact-split {
    display: grid;
    gap: var(--space-lg);
  }

  .contact-copy {
    min-width: 0;
    display: grid;
    gap: var(--space-md);
    align-content: center;
  }

  .page-title {
    margin-bottom: 0;
  }

  .page-intro {
    max-width: 36rem;
    margin-bottom: 0;
  }

  .contact-block .section-title {
    margin-bottom: var(--space-sm);
  }

  .contact-name {
    margin-bottom: var(--space-xs);
    color: var(--color-text-muted);
  }

  .contact-link {
    font-size: 1.1rem;
    color: var(--color-accent);
  }

  .contact-link:hover {
    color: var(--color-accent-hover);
  }

  .contact-photo {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 900px) {
    .contact-split.has-photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
    }

    .contact-photo {
      height: min(32rem, calc(100svh - var(--header-height) - var(--announcement-banner-height) - 6rem));
      max-height: none;
      aspect-ratio: auto;
      object-fit: cover;
    }
  }
</style>
