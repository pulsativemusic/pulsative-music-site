---
import BaseLayout from '../components/layout/BaseLayout.astro';
import DomeGallery from '../components/islands/DomeGallery';
import { getPhotos, getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'fotos')) {
  return Astro.redirect(pathFor('home', locale));
}

const photos = await getPhotos();
const ui = getUi(locale);
const intro = pickLocalized(settings.fotosIntro, locale);

const domeImages = photos.map((photo) => ({
  src: photo.imageUrl,
  alt: pickLocalized(photo.title, locale) || '',
  objectPosition: photo.objectPosition,
}));
---

<BaseLayout title={ui.fotos.domeTitle} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <p class="section-kicker reveal">{ui.fotos.domeKicker}</p>
      <h1 class="page-title reveal reveal-delay-1">{ui.fotos.domeTitle}</h1>
      <p class="page-intro text-muted reveal reveal-delay-2">{ui.fotos.domeNote}</p>
      <p class="back-link reveal reveal-delay-2">
        <a href={pathFor('fotos', locale)}>{ui.fotos.backToGrid}</a>
      </p>
    </div>
  </section>

  <section class="dome-section" aria-label={ui.fotos.domeTitle}>
    {
      photos.length === 0 ? (
        <p class="empty text-muted container">No photos yet.</p>
      ) : (
        <DomeGallery
          client:only="react"
          images={domeImages}
          grayscale={false}
          overlayBlurColor="#09090b"
          segments={35}
          fit={0.55}
          minRadius={480}
        />
      )
    }
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }

  .back-link {
    margin-top: var(--space-md);
  }

  .back-link a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-size: 0.95rem;
  }

  .back-link a:hover {
    color: var(--color-accent);
  }

  .dome-section {
    position: relative;
    width: 100%;
    height: min(100vh, 900px);
    min-height: 420px;
    margin-bottom: var(--space-xl);
  }

  .empty {
    padding: var(--space-lg) 0;
  }
</style>
