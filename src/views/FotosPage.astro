---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import PhotoLightbox from '../components/islands/PhotoLightbox';
import { getPhotos, getSiteSettings, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'fotos')) {
  return Astro.redirect(pathFor('home', locale));
}

const photos = await getPhotos();
const ui = getUi(locale);
const intro = pickLocalized(settings.fotosIntro, locale);
---

<BaseLayout title={ui.fotos.title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{ui.fotos.title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-1">{intro}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <PhotoGrid photos={photos} locale={locale} />
      <PhotoLightbox client:load downloadLabel={ui.fotos.download} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }
</style>
