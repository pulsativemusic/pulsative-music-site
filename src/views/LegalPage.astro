---
import BaseLayout from '../components/layout/BaseLayout.astro';
import LegalContent from '../components/LegalContent.astro';
import { getLegalPage, getSiteSettings } from '../lib/data';
import { getUi } from '../lib/i18n';
import { mockLegalPages } from '../lib/mock-data';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
  slug: 'impressum' | 'privacy';
}

const { locale, slug } = Astro.props;
const settings = await getSiteSettings();
const ui = getUi(locale);
const page =
  (await getLegalPage(slug, locale)) ??
  mockLegalPages.find((p) => p.slug === slug && p.locale === locale)!;

const description = slug === 'impressum' ? ui.seo.legalImpressum : ui.seo.legalPrivacy;
---

<BaseLayout title={page.title} description={description} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{page.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <LegalContent page={page} />
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
  }
</style>
