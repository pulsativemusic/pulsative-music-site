---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import Button from '../components/Button.astro';
import {
  getPastShows,
  getSiteSettings,
  getUpcomingShows,
  isLivePageEnabled,
} from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isLivePageEnabled(settings)) {
  return Astro.redirect(pathFor('home', locale));
}

const ui = getUi(locale);
const upcomingShows = await getUpcomingShows();
const pastShows = await getPastShows();
const intro = pickLocalized(settings.liveIntro, locale);
---

<BaseLayout title={ui.live.title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{ui.live.title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-1">{intro}</p>}
      <Button href="/live/calendar.ics" variant="outline" class="reveal reveal-delay-2">
        {ui.live.calendar}
      </Button>
    </div>
  </section>

  <section class="section shows-section">
    <div class="container">
      <header class="shows-section-header reveal">
        <h2 class="section-title">{ui.live.upcoming}</h2>
      </header>
      <ShowList shows={upcomingShows} locale={locale} />
    </div>
  </section>

  {
    pastShows.length > 0 && (
      <section class="section section-alt shows-section">
        <div class="container">
          <header class="shows-section-header reveal">
            <h2 class="section-title">{ui.live.past}</h2>
          </header>
          <ShowList shows={pastShows} compact locale={locale} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-hero {
    padding-bottom: var(--space-lg);
    container-type: inline-size;
  }

  /* Button is a child component — need :global to pierce Astro scope */
  .page-hero :global(.btn) {
    max-width: 100%;
    box-sizing: border-box;
    font-size: clamp(0.68rem, 0.5rem + 1cqi, 0.85rem);
    letter-spacing: clamp(0.08em, 0.04em + 0.35cqi, 0.16em);
    padding-inline: clamp(0.9rem, 0.4rem + 2cqi, 1.6rem);
    white-space: nowrap;
  }

  @container (max-width: 24rem) {
    .page-hero :global(.btn) {
      white-space: normal;
      line-height: 1.25;
      text-align: center;
      text-wrap: balance;
    }
  }

  .page-title {
    font-size: clamp(3rem, 10vw, 6rem);
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
    margin-bottom: var(--space-lg);
  }

  .shows-section {
    padding-block: var(--space-2xl);
  }

  .shows-section-header {
    margin-bottom: var(--space-xl);
    min-width: 0;
    container-type: inline-size;
  }

  .shows-section .section-title {
    line-height: 1.15;
    /* Fallback: shrink with the header so long DE words fit intact */
    font-size: clamp(1.6rem, 0.85rem + 4.6cqi, 4rem);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  @supports (text-fit: shrink) {
    .shows-section .section-title {
      font-size: clamp(2.5rem, 6vw, 4rem);
      text-fit: shrink 50%;
    }
  }

  .section-alt {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
  }
</style>
