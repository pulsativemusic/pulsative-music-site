---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import Button from '../components/Button.astro';
import {
  getPastShows,
  getSiteSettings,
  getUpcomingShows,
  isLivePageEnabled,
} from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isLivePageEnabled(settings)) {
  return Astro.redirect(pathFor('home', locale));
}

const ui = getUi(locale);
const upcomingShows = await getUpcomingShows();
const pastShows = await getPastShows();
const title = pickLocalized(settings.liveTitle, locale) || ui.live.title;
const intro = pickLocalized(settings.liveIntro, locale);
const liveImageUrl = settings.liveImageUrl;
const hasPhoto = Boolean(liveImageUrl);
---

<BaseLayout title={title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container live-copy">
      <h1 class="page-title reveal">{title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-1">{intro}</p>}
      <Button href="/live/calendar.ics" variant="outline" class="reveal reveal-delay-2">
        {ui.live.calendar}
      </Button>
    </div>
  </section>

  <section class="section live-body">
    <div class="container">
      <div class:list={['live-layout', { 'live-layout--photo': hasPhoto }]}>
        {
          liveImageUrl && (
            <img
              class="live-photo reveal"
              src={liveImageUrl}
              alt={settings.bandName}
              loading="eager"
              width={1200}
              height={800}
            />
          )
        }

        <div class="live-shows">
          <div class="shows-block">
            <header class="shows-section-header reveal">
              <h2 class="section-title">{ui.live.upcoming}</h2>
            </header>
            <ShowList shows={upcomingShows} locale={locale} />
          </div>

          {
            pastShows.length > 0 && (
              <div class="shows-block shows-past">
                <header class="shows-section-header reveal">
                  <h2 class="section-title">{ui.live.past}</h2>
                </header>
                <ShowList shows={pastShows} past compact locale={locale} />
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-md) var(--space-sm);
    container-type: inline-size;
  }

  .live-copy {
    min-width: 0;
  }

  /* Button is a child component — need :global to pierce Astro scope */
  .page-hero :global(.btn) {
    max-width: 100%;
    box-sizing: border-box;
    font-size: clamp(0.68rem, 0.5rem + 1cqi, 0.85rem);
    letter-spacing: clamp(0.08em, 0.04em + 0.35cqi, 0.16em);
    padding-inline: clamp(0.9rem, 0.4rem + 2cqi, 1.6rem);
    white-space: nowrap;
  }

  @container (max-width: 24rem) {
    .page-hero :global(.btn) {
      white-space: normal;
      line-height: 1.25;
      text-align: center;
      text-wrap: balance;
    }
  }

  .page-title {
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
    margin-bottom: var(--space-md);
  }

  .live-body {
    padding-block: var(--space-md) var(--space-2xl);
  }

  .live-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .live-shows {
    display: grid;
    gap: var(--space-2xl);
    min-width: 0;
  }

  .shows-section-header {
    margin-bottom: var(--space-md);
    min-width: 0;
    container-type: inline-size;
  }

  /* Fit long DE titles in the half-width column without oversized text-fit */
  .live-shows .section-title {
    line-height: 1.15;
    font-size: clamp(1.5rem, 0.9rem + 3.2cqi, 2.75rem);
    text-wrap: balance;
  }

  .shows-past {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .live-photo {
    width: 100%;
    max-height: 22rem;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  /* Desktop: shows left, photo right */
  @media (min-width: 900px) {
    .live-layout--photo {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    .live-layout--photo .live-shows {
      grid-column: 1;
      grid-row: 1;
    }

    .live-layout--photo .live-photo {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--announcement-banner-height) + var(--space-md));
      max-height: calc(100svh - var(--header-height) - var(--announcement-banner-height) - 2 * var(--space-md));
      aspect-ratio: 4 / 3;
      height: auto;
    }
  }
</style>
