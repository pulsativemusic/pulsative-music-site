---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getPressAssets, getSiteSettings, isNavPageEnabled } from '../lib/data';
import type { Locale, PressAssetType } from '../lib/types';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'promoKit')) {
  return Astro.redirect(pathFor('home', locale));
}

const assets = await getPressAssets();
const ui = getUi(locale);
const title = pickLocalized(settings.promoKitTitle, locale) || ui.promoKit.title;

const groups: { key: PressAssetType; label: string }[] = [
  { key: 'pressKit', label: ui.promoKit.pressKit },
  { key: 'technicalRider', label: ui.promoKit.technicalRider },
];

const assetsByType = (type: PressAssetType) =>
  assets.filter((asset) => asset.assetType === type);
---

<BaseLayout title={title} description={ui.seo.promoKit} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{title}</h1>
      <p class="page-intro text-muted reveal reveal-delay-1">{ui.promoKit.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        groups.map((group) => {
          const items = assetsByType(group.key);
          return (
            <div class="press-group reveal">
              <h2 class="section-title">{group.label}</h2>
              {items.length === 0 ? (
                <p class="text-muted">{ui.promoKit.comingSoon}</p>
              ) : (
                <div class="press-grid">
                  {items.map((asset) => (
                    <article class="press-card">
                      <h3>{asset.title}</h3>
                      {asset.description && <p class="text-muted">{asset.description}</p>}
                      {asset.fileUrl ? (
                        <Button href={asset.fileUrl} variant="outline" download>
                          {ui.promoKit.download}
                        </Button>
                      ) : (
                        <span class="coming-soon">{ui.promoKit.comingSoon}</span>
                      )}
                    </article>
                  ))}
                </div>
              )}
            </div>
          );
        })
      }

      <div class="press-contact reveal">
        <h2 class="section-title">{ui.promoKit.bookingPress}</h2>
        <p class="text-muted">{ui.promoKit.bookingPressText}</p>
        <a href={`mailto:${settings.bookingEmail}`} class="contact-email">
          {settings.bookingEmail}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: var(--space-sm);
  }

  .press-group {
    margin-bottom: var(--space-2xl);
  }

  .press-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .press-card {
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .press-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .press-card .btn,
  .coming-soon {
    display: inline-block;
    margin-top: var(--space-md);
  }

  .coming-soon {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .press-contact {
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .contact-email {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: 1.25rem;
    color: var(--color-accent);
  }
</style>
