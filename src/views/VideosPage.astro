---
import BaseLayout from '../components/layout/BaseLayout.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { getSiteSettings, getVideos, isNavPageEnabled } from '../lib/data';
import { getUi, pathFor, pickLocalized } from '../lib/i18n';
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const settings = await getSiteSettings();

if (!isNavPageEnabled(settings, 'videos')) {
  return Astro.redirect(pathFor('home', locale));
}

const videos = await getVideos();
const ui = getUi(locale);
const intro = pickLocalized(settings.videosIntro, locale);
---

<BaseLayout title={ui.videos.title} description={intro} settings={settings}>
  <section class="page-hero section">
    <div class="container">
      <h1 class="page-title reveal">{ui.videos.title}</h1>
      {intro && <p class="page-intro text-muted reveal reveal-delay-1">{intro}</p>}
    </div>
  </section>

  {
    videos.length > 0 && (
      <section class="section">
        <div class="container">
          <VideoGrid videos={videos} locale={locale} />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-title {
    margin-bottom: var(--space-sm);
  }

  .page-intro {
    max-width: 36rem;
  }
</style>
